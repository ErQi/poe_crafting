{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "electron/dist",
    "rootDir": "electron",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["electron/**/*.ts"],
  "exclude": ["electron/overlay.ts"]
}
