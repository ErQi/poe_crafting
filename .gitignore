# 本地环境变量；示例配置仍可提交
.env
.env.*
!.env.example

# IDE / 编辑器
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# 备份与本地迁移残留
*.bak
*.orig
*.tmp

# Python 历史残留
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# .NET 用户文件
*.user
*.suo

# assets/build 是 electron-builder 的 buildResources（icon.ico 等），
# 不能被上面那条通用 build/ 规则挡掉
!assets/build/

# 运行时配置（出厂默认在 config/defaults/）
config/*
!config/defaults/

# 标价补丁的客户端基线、事务状态和临时文件
/price-patch/

# 客户端增强的基线、事务状态和临时文件
/client-enhancements/

# 用户自己截的模板与标定截图，不该进仓库
assets/templates/*.jpg
assets/templates/*.jpeg
assets/templates/*.bmp
assets/templates/*.webp
