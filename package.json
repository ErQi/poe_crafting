{
  "name": "poe-crafting",
  "private": true,
  "version": "0.5.0",
  "description": "POE Tools",
  "productName": "POE Tools",
  "author": "Faith",
  "main": "electron/dist/main.js",
  "scripts": {
    "build:patcher": "node scripts/build-patcher.cjs",
    "build:electron": "node scripts/build-electron.cjs",
    "build:web": "npm run build --prefix web",
    "build": "npm run build:web && npm run build:electron",
    "build:exe": "npm run build:patcher && npm run build && electron-builder --win portable",
    "dev": "npm run build:patcher && node scripts/dev.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "npm run build:patcher && npm run build && electron .",
    "postinstall": "npm install --prefix web"
  },
  "dependencies": {
    "koffi": "^2.11.0",
    "opencv-wasm": "^4.3.0-10"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.poe.crafting",
    "directories": {
      "output": "release",
      "buildResources": "assets/build"
    },
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/opencv-wasm/**",
      "assets/patcher/**"
    ],
    "files": [
      "package.json",
      "electron/dist/**/*",
      "!electron/dist/*.map",
      "web/dist/**/*",
      "config/defaults/*.json",
      "assets/patcher/win-x64/**/*",
      "assets/templates/README.txt",
      "!node_modules/koffi/build/koffi/!(win32_${arch})/**",
      "!node_modules/koffi/build/koffi/*/*.{exp,lib}",
      "!node_modules/koffi/{doc,lib,src,vendor}/**",
      "!node_modules/opencv-wasm/{opencv-bin.js,opencv-deno.js,mod.ts}",
      "!node_modules/opencv-wasm/types/**"
    ],
    "win": {
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "POE-Tools-${version}-portable.${ext}",
      "requestExecutionLevel": "admin"
    }
  }
}
